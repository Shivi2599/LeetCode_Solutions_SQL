import pandas as pd

def sales_person(sales_person: pd.DataFrame, company: pd.DataFrame, orders: pd.DataFrame) -> pd.DataFrame:
    red_company = company[company['name'] == 'RED']['com_id']
    red_company_orders = orders[orders['com_id'].isin(red_company)]['sales_id'].unique()
    sales_person_with_no_orders_in_red = sales_person[~sales_person['sales_id'].isin(red_company_orders)][['name']]
    return sales_person_with_no_orders_in_red
